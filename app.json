{
  "expo": {
    "name": "colors-app",
    "slug": "colors-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "colorsapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#332F3D",
        "foregroundImage": "./assets/images/icon.png",
        "backgroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.javisa01.colorsapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#332F3D",
          "image": "./assets/images/icon.png",
          "imageWidth": 76
        }
      ],
      "expo-localization",
      "expo-audio",
      "expo-secure-store",
      "@clerk/expo",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "_apiUrl": "URL del backend. Vacio = se deduce la IP del servidor de Metro. Para produccion usa EXPO_PUBLIC_API_URL o pon aqui la URL de Neon/hosting.",
      "apiUrl": "",
      "eas": {
        "projectId": "37f0270b-d134-4e31-8808-afc692bb3d0e"
      },
      "_clerkPublishableKey": "Clave publicable de Clerk. Vacio = se usa EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY del .env.local. No es un secreto, pero es mas comodo dejarla en el entorno.",
      "clerkPublishableKey": ""
    }
  }
}
