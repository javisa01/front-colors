# ---------------------------------------------------------------------------
# Copia este fichero a `.env` y ajusta los valores.
#   cp .env.example .env
#
# En Expo, solo las variables con prefijo EXPO_PUBLIC_ llegan al cliente.
# Se incrustan en el bundle: NUNCA pongas aqui un secreto.
# ---------------------------------------------------------------------------

# URL del backend (back-colors).
#
# Dejalo VACIO o sin definir en desarrollo: la app deduce sola la IP de tu PC
# a partir del servidor de Metro, asi funciona en el movil fisico sin tocar nada.
#
# Definelo cuando el backend no este en tu maquina:
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:4000
#   EXPO_PUBLIC_API_URL=https://api.tudominio.com
EXPO_PUBLIC_API_URL=

# Clave publicable de Clerk (autenticacion del modo online).
#
# NO es un secreto: identifica tu instancia y viaja en el bundle. La clave
# SECRETA (sk_...) no va aqui, va en el backend.
#
# La rellena `clerk env pull`, que escribe `.env.local`. Si prefieres tenerla
# fija en el repo, ponla en `expo.extra.clerkPublishableKey` de app.json.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
